---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import AboutSection from '../components/AboutSection.astro';
import LeadershipSection from '../components/LeadershipSection.astro';
import ActivitiesSection from '../components/ActivitiesSection.astro';
import ScheduleSection from '../components/ScheduleSection.astro';
import GallerySection from '../components/GallerySection.astro';
import RulesFaqSection from '../components/RulesFaqSection.astro';
import JoinSection from '../components/JoinSection.astro';
import Footer from '../components/Footer.astro';
import { communityInfo, communityRulesFaq } from '../data/community';

const siteOrigin = (Astro.site ?? new URL('https://winstreakparty.my.id')).toString().replace(/\/$/, '');

const homeSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: communityInfo.name,
    alternateName: communityInfo.shortName,
    url: siteOrigin,
    logo: `${siteOrigin}/images/brand/wsp-logo-mark.png`,
    description: communityInfo.tagline,
    sameAs: [
      communityInfo.channels.discordUrl,
      communityInfo.channels.instagramUrl,
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: communityInfo.name,
    url: siteOrigin,
    inLanguage: 'id-ID',
    description: communityInfo.tagline,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: communityRulesFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<BaseLayout jsonLd={homeSchemas}>
  <Header />
  <main id="konten-utama">
    <Hero />
    <AboutSection />
    <LeadershipSection />
    <ActivitiesSection />
    <ScheduleSection />
    <GallerySection />
    <RulesFaqSection />
    <JoinSection />
  </main>
  <Footer />
</BaseLayout>
