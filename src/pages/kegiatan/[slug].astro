---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Picture from '../../components/Picture.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('kegiatan')).sort((a, b) =>
    b.data.date.localeCompare(a.data.date)
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      relatedPosts: posts.filter((p) => p.id !== post.id).slice(0, 2),
    },
  }));
}

const { post, relatedPosts } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(post.data.date));

const wordCount = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 200));

const siteOrigin = (Astro.site ?? new URL('https://winstreakparty.my.id')).toString().replace(/\/$/, '');
const articleUrl = `${siteOrigin}/kegiatan/${post.id}`;
const coverUrl = new URL(post.data.cover, siteOrigin).toString();

const articleSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Beranda',
        item: `${siteOrigin}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Rekap Kegiatan',
        item: `${siteOrigin}/kegiatan`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: post.data.title,
        item: articleUrl,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.summary,
    image: coverUrl,
    datePublished: post.data.date,
    inLanguage: 'id-ID',
    mainEntityOfPage: articleUrl,
    author: {
      '@type': 'Organization',
      name: 'Win Streak Party',
      url: siteOrigin,
    },
    publisher: {
      '@type': 'Organization',
      name: 'Win Streak Party',
      logo: {
        '@type': 'ImageObject',
        url: `${siteOrigin}/images/brand/wsp-logo-mark.png`,
      },
    },
  },
];
---

<BaseLayout
  title={`${post.data.title} — Win Streak Party`}
  description={post.data.summary}
  ogImage={post.data.cover}
  ogImageAlt={post.data.coverAlt}
  ogType="article"
  publishedTime={post.data.date}
  jsonLd={articleSchemas}
>
  <Header />
  <div class="read-progress-track" aria-hidden="true">
    <div class="read-progress-bar" data-read-progress></div>
  </div>
  <main id="konten-utama">
    <article class="article-shell" data-article-root>
      <header class="wrap article-head">
        <nav class="breadcrumb" aria-label="Jejak halaman">
          <a href="/">Beranda</a>
          <span aria-hidden="true">/</span>
          <a href="/kegiatan">Rekap Kegiatan</a>
        </nav>

        <div class="article-meta">
          <span class="article-category">{post.data.category}</span>
          <time datetime={post.data.date}>{formattedDate}</time>
          <span class="meta-dot" aria-hidden="true">·</span>
          <span>{readingMinutes} menit baca</span>
        </div>

        <h1 class="article-title">{post.data.title}</h1>
        <p class="article-summary">{post.data.summary}</p>
      </header>

      <div class="wrap article-cover-wrap">
        <div class="article-cover">
          <Picture
            src={post.data.cover}
            alt={post.data.coverAlt}
            sizes="(max-width: 960px) 100vw, 960px"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="wrap article-body-wrap">
        <div class="prose">
          <Content />
        </div>

        {relatedPosts.length > 0 && (
          <section class="related-block" aria-labelledby="related-heading">
            <h2 id="related-heading" class="related-heading">Catatan kegiatan lainnya</h2>
            <div class="related-grid">
              {relatedPosts.map((rel) => (
                <a class="related-card" href={`/kegiatan/${rel.id}`}>
                  <span class="related-cat">{rel.data.category}</span>
                  <span class="related-title">{rel.data.title}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <aside class="article-cta">
          <h2 class="cta-title">Ingin ikut sesi berikutnya?</h2>
          <p class="cta-desc">
            Masuk ke lobi Discord atau isi formulir pendaftaran member untuk ikut mabar 5-stack dan nobar MPL bareng Win Streak Party.
          </p>
          <div class="cta-actions">
            <a class="btn btn-primary" href="/#gabung">Gabung Komunitas</a>
            <a class="btn btn-secondary" href="/kegiatan">Kembali ke rekap kegiatan</a>
          </div>
        </aside>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .read-progress-track {
    position: fixed;
    top: var(--header-h);
    inset-inline: 0;
    height: 2.5px;
    z-index: 85;
    pointer-events: none;
  }

  .read-progress-bar {
    width: 100%;
    height: 100%;
    background-color: var(--brand-gold);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .article-shell {
    padding-block: clamp(2.5rem, 5vw, 4rem) var(--section-py);
  }

  .article-head {
    max-width: calc(780px + var(--gutter) * 2);
    display: grid;
    gap: 1.05rem;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-subtle);
  }

  .breadcrumb a {
    color: var(--color-accent);
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .breadcrumb a:hover {
      text-decoration: underline;
    }
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-subtle);
  }

  .meta-dot {
    color: var(--color-border-strong);
  }

  .article-category {
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-tag-online-bg);
    color: var(--color-tag-online-text);
  }

  .article-title {
    font-size: clamp(2.1rem, 4vw, 3.25rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.028em;
    color: var(--color-heading);
  }

  .article-summary {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    max-width: 60ch;
  }

  .article-cover-wrap {
    max-width: calc(960px + var(--gutter) * 2);
    margin-block: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .article-cover {
    overflow: hidden;
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-muted);
    aspect-ratio: 16 / 10;
  }

  .article-body-wrap {
    max-width: calc(740px + var(--gutter) * 2);
    display: grid;
    gap: 3rem;
  }

  .prose {
    display: grid;
    gap: 1.25rem;
    font-size: var(--text-base);
    line-height: 1.72;
    color: var(--color-ink);
  }

  .prose :global(h2) {
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    font-weight: 800;
    color: var(--color-heading);
    margin-top: 1.15rem;
    letter-spacing: -0.022em;
  }

  .prose :global(p) {
    max-width: 66ch;
    color: var(--color-ink-muted);
  }

  .prose :global(ol),
  .prose :global(ul) {
    margin: 0;
    padding-left: 1.35rem;
    display: grid;
    gap: 0.65rem;
    color: var(--color-ink-muted);
  }

  .prose :global(strong) {
    color: var(--color-ink);
  }

  .prose :global(code) {
    padding: 0.14rem 0.42rem;
    border-radius: 6px;
    background-color: var(--color-surface-muted);
    color: var(--color-accent);
    font-size: 0.92em;
  }

  .related-block {
    display: grid;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border-strong);
  }

  .related-heading {
    font-size: var(--text-h3);
    font-weight: 800;
    color: var(--color-heading);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .related-card {
    display: grid;
    gap: 0.45rem;
    align-content: start;
    padding: 1.15rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-strong);
    background-color: var(--color-surface);
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .related-cat {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent);
  }

  .related-title {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.28;
    color: var(--color-heading);
  }

  @media (hover: hover) and (pointer: fine) {
    .related-card:hover {
      border-color: var(--color-accent);
      transform: translateY(-2px);
    }
  }

  .article-cta {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    display: grid;
    gap: 0.9rem;
  }

  .cta-title {
    font-size: var(--text-h3);
    font-weight: 800;
    color: var(--color-heading);
  }

  .cta-desc {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.25rem;
  }

  @media (max-width: 620px) {
    .related-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 540px) {
    .cta-actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    .cta-actions .btn {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .related-card:hover {
      transform: none;
    }
  }
</style>

<script>
  const progressBar = document.querySelector<HTMLElement>('[data-read-progress]');
  const articleEl = document.querySelector<HTMLElement>('[data-article-root]');

  if (progressBar && articleEl) {
    let ticking = false;

    const updateProgress = () => {
      const rect = articleEl.getBoundingClientRect();
      const scrollable = Math.max(1, articleEl.offsetHeight - window.innerHeight);
      const passed = Math.min(scrollable, Math.max(0, -rect.top));
      const ratio = passed / scrollable;
      progressBar.style.transform = `scaleX(${ratio.toFixed(4)})`;
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        window.requestAnimationFrame(updateProgress);
      }
    };

    updateProgress();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>
