---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('kegiatan');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(post.data.date));
---

<BaseLayout
  title={`${post.data.title} — Win Streak Party`}
  description={post.data.summary}
  ogImage={post.data.cover}
>
  <Header />
  <main id="konten-utama">
    <article class="article-shell">
      <header class="wrap article-head">
        <nav class="breadcrumb" aria-label="Jejak halaman">
          <a href="/">Beranda</a>
          <span aria-hidden="true">/</span>
          <a href="/kegiatan">Rekap Kegiatan</a>
        </nav>

        <div class="article-meta">
          <span class="article-category">{post.data.category}</span>
          <time datetime={post.data.date}>{formattedDate}</time>
        </div>

        <h1 class="article-title">{post.data.title}</h1>
        <p class="article-summary">{post.data.summary}</p>
      </header>

      <div class="wrap article-cover-wrap">
        <div class="article-cover">
          <img
            src={post.data.cover}
            alt={post.data.coverAlt}
            width="1264"
            height="848"
          />
        </div>
      </div>

      <div class="wrap article-body-wrap">
        <div class="prose">
          <Content />
        </div>

        <aside class="article-cta">
          <h2 class="cta-title">Ingin ikut sesi berikutnya?</h2>
          <p class="cta-desc">
            Masuk ke lobi Discord atau isi formulir pendaftaran member untuk ikut mabar 5-stack dan nobar MPL bareng Win Streak Party.
          </p>
          <div class="cta-actions">
            <a class="btn btn-primary" href="/#gabung">Gabung Komunitas</a>
            <a class="btn btn-secondary" href="/kegiatan">Kembali ke rekap kegiatan</a>
          </div>
        </aside>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .article-shell {
    padding-block: clamp(2.5rem, 5vw, 4rem) var(--section-py);
  }

  .article-head {
    max-width: calc(780px + var(--gutter) * 2);
    display: grid;
    gap: 1.05rem;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-subtle);
  }

  .breadcrumb a {
    color: var(--color-indigo);
    text-decoration: none;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-subtle);
  }

  .article-category {
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-tint);
    color: var(--color-indigo);
  }

  .article-title {
    font-size: clamp(2.1rem, 4vw, 3.25rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.028em;
    color: var(--color-indigo);
  }

  .article-summary {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    max-width: 60ch;
  }

  .article-cover-wrap {
    max-width: calc(960px + var(--gutter) * 2);
    margin-block: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .article-cover {
    overflow: hidden;
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-muted);
    aspect-ratio: 16 / 10;
  }

  .article-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-body-wrap {
    max-width: calc(740px + var(--gutter) * 2);
    display: grid;
    gap: 3rem;
  }

  .prose {
    display: grid;
    gap: 1.25rem;
    font-size: var(--text-base);
    line-height: 1.72;
    color: var(--color-ink);
  }

  .prose :global(h2) {
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    font-weight: 800;
    color: var(--color-indigo);
    margin-top: 1.15rem;
    letter-spacing: -0.022em;
  }

  .prose :global(p) {
    max-width: 66ch;
    color: var(--color-ink-muted);
  }

  .prose :global(ol),
  .prose :global(ul) {
    margin: 0;
    padding-left: 1.35rem;
    display: grid;
    gap: 0.65rem;
    color: var(--color-ink-muted);
  }

  .prose :global(strong) {
    color: var(--color-ink);
  }

  .prose :global(code) {
    padding: 0.14rem 0.42rem;
    border-radius: 6px;
    background-color: var(--color-surface-muted);
    color: var(--color-indigo);
    font-size: 0.92em;
  }

  .article-cta {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    display: grid;
    gap: 0.9rem;
  }

  .cta-title {
    font-size: var(--text-h3);
    font-weight: 800;
    color: var(--color-indigo);
  }

  .cta-desc {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.25rem;
  }

  @media (max-width: 540px) {
    .cta-actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    .cta-actions .btn {
      width: 100%;
    }
  }
</style>
