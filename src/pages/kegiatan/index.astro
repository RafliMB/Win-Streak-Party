---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('kegiatan')).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);

const formatDate = (iso: string) =>
  new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(new Date(iso));
---

<BaseLayout
  title="Rekap Kegiatan — Win Streak Party"
  description="Arsip catatan mabar 5-stack, internal scrim, turnamen mini, dan nobar MPL komunitas Mobile Legends Win Streak Party."
>
  <Header />
  <main id="konten-utama">
    <section class="page-head">
      <div class="wrap page-head-inner">
        <nav class="breadcrumb" aria-label="Jejak halaman">
          <a href="/">Beranda</a>
          <span aria-hidden="true">/</span>
          <span>Rekap Kegiatan</span>
        </nav>
        <h1 class="page-title">Rekap kegiatan dan catatan lobi</h1>
        <p class="page-lead">
          Dokumentasi tertulis tiap sesi mabar, format internal scrim, dan liputan nobar MPL. Artikel baru cukup ditambahkan dalam format Markdown di folder konten proyek.
        </p>
      </div>
    </section>

    <section class="archive-section" aria-label="Daftar artikel kegiatan">
      <div class="wrap archive-grid">
        {posts.map((post) => (
          <article class="post-card">
            <a class="post-link" href={`/kegiatan/${post.id}`}>
              <div class="post-cover">
                <img
                  src={post.data.cover}
                  alt={post.data.coverAlt}
                  width="1200"
                  height="800"
                  decoding="async"
                />
              </div>

              <div class="post-meta">
                <span class="post-category">{post.data.category}</span>
                <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
              </div>

              <h2 class="post-title">{post.data.title}</h2>
              <p class="post-summary">{post.data.summary}</p>
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 5vw, 4.25rem) clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--color-border);
  }

  .page-head-inner {
    display: grid;
    gap: 1rem;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-subtle);
  }

  .breadcrumb a {
    color: var(--color-indigo);
    text-decoration: none;
  }

  .page-title {
    font-size: var(--text-h1);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-indigo);
    max-width: 18ch;
  }

  .page-lead {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    max-width: 56ch;
  }

  .archive-section {
    padding-block: var(--section-py);
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  .post-card {
    min-width: 0;
  }

  .post-link {
    display: grid;
    gap: 0.85rem;
    text-decoration: none;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .post-cover {
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--color-surface-muted);
    aspect-ratio: 3 / 2;
  }

  .post-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .post-link:hover {
      transform: translateY(-2px);
    }

    .post-link:hover .post-cover img {
      transform: scale(1.03);
    }

    .post-link:hover .post-title {
      color: var(--color-indigo-soft);
    }
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-ink-subtle);
    font-weight: 600;
  }

  .post-category {
    padding: 0.28rem 0.75rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-tint);
    color: var(--color-indigo);
  }

  .post-title {
    font-size: 1.325rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-indigo);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .post-summary {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    line-height: 1.58;
  }

  @media (max-width: 960px) {
    .archive-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .archive-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
