---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Picture from '../components/Picture.astro';
import { upcomingEvents } from '../data/community';

const siteOrigin = (Astro.site ?? new URL('https://winstreakparty.my.id')).toString().replace(/\/$/, '');

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Beranda',
      item: `${siteOrigin}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Turnamen dan Event',
      item: `${siteOrigin}/turnamen`,
    },
  ],
};
---

<BaseLayout
  title="Turnamen & Event — Win Streak Party"
  description="Daftar fun tournament Mobile Legends 5v5, agenda nobar MPL, dan arsip Hall of Fame komunitas Win Streak Party."
  jsonLd={breadcrumbSchema}
>
  <Header />
  <main id="konten-utama">
    <section class="page-head">
      <div class="wrap page-head-inner">
        <nav class="breadcrumb" aria-label="Jejak halaman">
          <a href="/">Beranda</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Turnamen dan Event</span>
        </nav>
        <h1 class="page-title">Turnamen internal dan agenda nobar</h1>
        <p class="page-lead">
          Kalender fun tournament Custom Draft Pick 5v5, nobar big match MPL, serta papan Hall of Fame skuad juara Win Streak Party.
        </p>
      </div>
    </section>

    <section class="events-section" aria-labelledby="events-list-title">
      <div class="wrap events-shell">
        <h2 id="events-list-title" class="section-heading">Agenda mendatang</h2>

        <div class="events-list">
          {upcomingEvents.map((ev, idx) => (
            <article class="event-row">
              <div class="event-media">
                <Picture
                  src={ev.image}
                  alt={ev.imageAlt}
                  sizes="(max-width: 900px) 100vw, 44vw"
                  loading={idx === 0 ? 'eager' : 'lazy'}
                />
              </div>

              <div class="event-body">
                <div class="event-top">
                  <span class={`status-pill status-${ev.status === 'Dibuka' ? 'open' : 'soon'}`}>
                    Pendaftaran {ev.status}
                  </span>
                  <span class="event-date">{ev.dateLabel}</span>
                </div>

                <h3 class="event-title">{ev.title}</h3>
                <p class="event-summary">{ev.summary}</p>

                <dl class="event-meta">
                  <div class="meta-pair">
                    <dt>Format</dt>
                    <dd>{ev.format}</dd>
                  </div>
                  <div class="meta-pair">
                    <dt>Lokasi</dt>
                    <dd>{ev.location}</dd>
                  </div>
                </dl>

                <ul class="event-rules">
                  {ev.rules.map((rule) => (
                    <li>{rule}</li>
                  ))}
                </ul>

                <div class="event-actions">
                  <a class="btn btn-primary" href="/#gabung">Daftar sebagai member</a>
                  <a class="btn btn-secondary" href="/#jadwal">Lihat jadwal rutin</a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <p class="placeholder-note">
          Agenda di atas merupakan template contoh event. Seluruh detail jadwal, syarat, dan status pendaftaran dapat diubah langsung pada berkas data situs.
        </p>
      </div>
    </section>

    <section class="hof band-dark" aria-labelledby="hof-title">
      <div class="wrap hof-grid">
        <div class="hof-copy">
          <h2 id="hof-title" class="hof-heading">Hall of Fame turnamen internal</h2>
          <p class="hof-lead">
            Papan kehormatan ini disiapkan khusus untuk mengabadikan nama skuad pemenang, susunan lima pemain, dan MVP dari setiap edisi WSP Fun Cup 5v5.
          </p>
        </div>

        <div class="hof-slot">
          <h3 class="hof-slot-title">Edisi perdana menunggu skuad juara pertama</h3>
          <p class="hof-slot-body">
            Belum ada pemenang tercatat pada musim ini. Kumpulkan lima pemain atau daftar individu lewat halaman pendaftaran untuk memperebutkan tempat pertama di papan Hall of Fame.
          </p>
          <a class="btn btn-gold" href="/#gabung">Ikut turnamen berikutnya</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 5vw, 4.25rem) clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--color-border);
  }

  .page-head-inner {
    display: grid;
    gap: 1rem;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-subtle);
  }

  .breadcrumb a {
    color: var(--color-accent);
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .breadcrumb a:hover {
      text-decoration: underline;
    }
  }

  .page-title {
    font-size: var(--text-h1);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-heading);
    max-width: 18ch;
  }

  .page-lead {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    max-width: 56ch;
  }

  .events-section {
    padding-block: var(--section-py);
  }

  .events-shell {
    display: grid;
    gap: 2.25rem;
  }

  .section-heading {
    font-size: var(--text-h2);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.028em;
    color: var(--color-heading);
  }

  .events-list {
    display: grid;
    gap: 2.5rem;
  }

  .event-row {
    display: grid;
    grid-template-columns: minmax(0, 5.2fr) minmax(0, 6.8fr);
    gap: clamp(1.75rem, 4vw, 3.25rem);
    align-items: start;
    padding-top: 2.25rem;
    border-top: 1px solid var(--color-border-strong);
  }

  .event-media {
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--color-surface-muted);
    aspect-ratio: 4 / 3;
    min-width: 0;
  }

  .event-body {
    display: grid;
    gap: 1.15rem;
    min-width: 0;
  }

  .event-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.38rem 0.9rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .status-open {
    background-color: var(--brand-gold);
    color: var(--brand-indigo-deep);
  }

  .status-soon {
    background-color: var(--color-tag-online-bg);
    color: var(--color-tag-online-text);
  }

  .event-date {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-muted);
  }

  .event-title {
    font-size: clamp(1.5rem, 2.5vw, 2.1rem);
    font-weight: 800;
    line-height: 1.14;
    letter-spacing: -0.024em;
    color: var(--color-heading);
  }

  .event-summary {
    color: var(--color-ink-muted);
  }

  .event-meta {
    margin: 0;
    border-top: 1px solid var(--color-border);
    display: grid;
  }

  .meta-pair {
    display: grid;
    grid-template-columns: minmax(0, 100px) minmax(0, 1fr);
    gap: 0.5rem 1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .meta-pair dt {
    font-weight: 700;
    color: var(--color-accent);
  }

  .meta-pair dd {
    margin: 0;
    color: var(--color-ink);
  }

  .event-rules {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.45rem;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .event-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.35rem;
  }

  .placeholder-note {
    font-size: var(--text-sm);
    color: var(--color-ink-subtle);
  }

  /* Hall of Fame dark band */
  .hof {
    background-color: var(--color-band-bg);
    color: var(--color-ink-on-dark);
    border-top: 1px solid var(--color-border-dark);
    padding-block: var(--section-py);
  }

  .hof-grid {
    display: grid;
    grid-template-columns: minmax(0, 5.5fr) minmax(0, 6.5fr);
    gap: clamp(2rem, 4.5vw, 4rem);
    align-items: center;
  }

  .hof-copy {
    display: grid;
    gap: 1rem;
  }

  .hof-heading {
    font-size: var(--text-h2);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.028em;
    color: var(--color-ink-on-dark);
  }

  .hof-lead {
    color: var(--color-ink-on-dark-muted);
  }

  .hof-slot {
    padding: clamp(1.5rem, 3.2vw, 2.5rem);
    border-radius: var(--radius-md);
    border: 1.5px dashed var(--color-border-dark-strong);
    background-color: var(--color-surface-dark-subtle);
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .hof-slot-title {
    font-size: var(--text-h3);
    font-weight: 800;
    color: var(--brand-gold);
  }

  .hof-slot-body {
    color: var(--color-ink-on-dark-muted);
    font-size: var(--text-base);
  }

  @media (max-width: 900px) {
    .event-row,
    .hof-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 540px) {
    .meta-pair {
      grid-template-columns: minmax(0, 1fr);
    }

    .event-actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    .event-actions .btn {
      width: 100%;
    }
  }
</style>
