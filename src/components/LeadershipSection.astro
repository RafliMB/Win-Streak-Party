---
import { communityLeaders } from '../data/community';
import RoleIcon from './RoleIcon.astro';

const leadCouncil = communityLeaders.filter((member) => member.level === 'lead');
const coreCouncil = communityLeaders.filter((member) => member.level === 'core');

const getInitials = (name: string): string => {
  const parts = name.trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return 'WS';
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return `${parts[0][0]}${parts[parts.length - 1][0]}`.toUpperCase();
};
---

<section class="leadership" id="petinggi" aria-labelledby="leadership-title">
  <div class="wrap leadership-shell">
    <div class="leadership-head">
      <div class="leadership-heading-wrap">
        <span class="leadership-eyebrow">Struktur Pengurus</span>
        <h2 id="leadership-title" class="leadership-heading">
          Jajaran petinggi Win Streak Party
        </h2>
        <p class="leadership-sub">
          Orang-orang di balik lobi 5-stack yang tertib, jadwal scrim yang rutin berjalan, dan suasana komunitas yang ramah bagi member baru maupun veteran.
        </p>
      </div>

      <div class="leadership-summary" aria-label="Ringkasan pengurus">
        <span class="summary-count">{communityLeaders.length}</span>
        <span class="summary-label">Pengurus aktif<br />lintas 5 role MLBB</span>
      </div>
    </div>

    {leadCouncil.length > 0 && (
      <ul class="leaders-lead-grid" aria-label="Pimpinan utama komunitas">
        {leadCouncil.map((leader) => (
          <li class="leader-card leader-card--lead">
            <div class="leader-top">
              <div class="leader-avatar-wrap">
                <div class="leader-avatar leader-avatar--lead">
                  {leader.avatar ? (
                    <img
                      src={leader.avatar}
                      alt={leader.avatarAlt ?? `Foto ${leader.name}, ${leader.title}`}
                      width="68"
                      height="68"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="avatar-initials" aria-hidden="true">
                      {getInitials(leader.name)}
                    </span>
                  )}
                </div>
                <span class="avatar-role-badge avatar-role-badge--lead" title={leader.role} aria-hidden="true">
                  <RoleIcon role={leader.role} size={14} />
                </span>
              </div>

              <div class="leader-identity">
                <span class="leader-title-pill">{leader.title}</span>
                <h3 class="leader-name">{leader.name}</h3>
                <p class="leader-ign">{leader.nickname}</p>
              </div>
            </div>

            <p class="leader-bio">{leader.bio}</p>

            {leader.motto && (
              <blockquote class="leader-motto">“{leader.motto}”</blockquote>
            )}

            <div class="leader-meta">
              <span class="meta-role">
                <span class="meta-role-icon" aria-hidden="true">
                  <RoleIcon role={leader.role} size={15} />
                </span>
                <span>{leader.role}</span>
              </span>
              <span class="meta-tier">{leader.tier}</span>
            </div>
          </li>
        ))}
      </ul>
    )}

    {coreCouncil.length > 0 && (
      <ul class="leaders-core-grid" aria-label="Koordinator divisi komunitas">
        {coreCouncil.map((leader) => (
          <li class="leader-card leader-card--core">
            <div class="leader-top">
              <div class="leader-avatar-wrap">
                <div class="leader-avatar leader-avatar--core">
                  {leader.avatar ? (
                    <img
                      src={leader.avatar}
                      alt={leader.avatarAlt ?? `Foto ${leader.name}, ${leader.title}`}
                      width="56"
                      height="56"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="avatar-initials" aria-hidden="true">
                      {getInitials(leader.name)}
                    </span>
                  )}
                </div>
                <span class="avatar-role-badge avatar-role-badge--core" title={leader.role} aria-hidden="true">
                  <RoleIcon role={leader.role} size={13} />
                </span>
              </div>

              <div class="leader-identity">
                <span class="leader-division">{leader.division}</span>
                <h3 class="leader-name">{leader.name}</h3>
                <p class="leader-role-title">{leader.title}</p>
                <p class="leader-ign">{leader.nickname}</p>
              </div>
            </div>

            <p class="leader-bio">{leader.bio}</p>

            <div class="leader-meta">
              <span class="meta-role">
                <span class="meta-role-icon" aria-hidden="true">
                  <RoleIcon role={leader.role} size={15} />
                </span>
                <span>{leader.role}</span>
              </span>
              <span class="meta-tier">{leader.tier}</span>
            </div>
          </li>
        ))}
      </ul>
    )}

    <p class="leadership-footnote">
      Profil petinggi di atas merupakan data contoh. Nama, IGN, jabatan, role, dan foto profil dapat disesuaikan kapan saja pada berkas data komunitas.
    </p>
  </div>
</section>

<style>
  .leadership {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-block: var(--section-py);
  }

  .leadership-shell {
    display: grid;
    gap: clamp(2rem, 3.8vw, 2.85rem);
  }

  .leadership-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
  }

  .leadership-heading-wrap {
    display: grid;
    gap: 0.7rem;
    min-width: 0;
  }

  .leadership-eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .leadership-heading {
    font-size: var(--text-h2);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.028em;
    color: var(--color-heading);
  }

  .leadership-sub {
    color: var(--color-ink-muted);
    max-width: 56ch;
  }

  .leadership-summary {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.8rem 1.2rem;
    border-radius: var(--radius-md);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-border-strong);
    flex-shrink: 0;
  }

  :global(:root[data-theme='dark']) .leadership-summary {
    background-color: var(--color-surface-muted);
  }

  .summary-count {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .summary-label {
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-ink-muted);
  }

  .leaders-lead-grid,
  .leaders-core-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.15rem, 2.2vw, 1.5rem);
  }

  .leaders-lead-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .leaders-core-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .leader-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    padding: clamp(1.35rem, 2.5vw, 1.75rem);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-border);
    min-width: 0;
    overflow: hidden;
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }

  :global(:root[data-theme='dark']) .leader-card {
    background-color: var(--color-surface-muted);
  }

  .leader-card--lead {
    border-color: var(--color-border-strong);
    padding-top: calc(clamp(1.35rem, 2.5vw, 1.75rem) + 4px);
  }

  .leader-card--lead::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--brand-indigo) 0%, var(--brand-gold) 100%);
    pointer-events: none;
  }

  :global(:root[data-theme='dark']) .leader-card--lead::before {
    background: linear-gradient(90deg, var(--brand-gold) 0%, #6d5cff 100%);
  }

  @media (hover: hover) and (pointer: fine) {
    .leader-card:hover {
      transform: translateY(-3px);
      border-color: var(--color-accent);
      box-shadow: var(--shadow-soft);
    }
  }

  .leader-top {
    display: flex;
    align-items: center;
    gap: 1.05rem;
    min-width: 0;
  }

  .leader-avatar-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .leader-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .leader-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .leader-avatar--lead {
    width: 68px;
    height: 68px;
    background: linear-gradient(145deg, var(--brand-indigo) 0%, var(--brand-indigo-deep) 100%);
    border: 2px solid rgba(251, 176, 59, 0.55);
    color: var(--brand-gold);
    box-shadow: 0 10px 22px -12px rgba(27, 20, 100, 0.55);
  }

  .leader-avatar--core {
    width: 56px;
    height: 56px;
    background-color: var(--color-surface-tint);
    border: 1.5px solid var(--color-border-strong);
    color: var(--color-heading);
  }

  .avatar-initials {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .leader-avatar--lead .avatar-initials {
    font-size: 1.45rem;
  }

  .leader-avatar--core .avatar-initials {
    font-size: 1.2rem;
  }

  .avatar-role-badge {
    position: absolute;
    right: -5px;
    bottom: -5px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: var(--radius-pill);
    border: 2px solid var(--color-canvas);
  }

  :global(:root[data-theme='dark']) .avatar-role-badge {
    border-color: var(--color-surface-muted);
  }

  .avatar-role-badge--lead {
    background-color: var(--brand-gold);
    color: var(--brand-indigo-deep);
  }

  .avatar-role-badge--core {
    background-color: var(--color-btn-primary-bg);
    color: var(--color-btn-primary-text);
  }

  .leader-identity {
    display: grid;
    gap: 0.22rem;
    min-width: 0;
  }

  .leader-title-pill {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.24rem 0.7rem;
    border-radius: var(--radius-pill);
    background-color: var(--brand-gold);
    color: var(--brand-indigo-deep);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    margin-bottom: 0.15rem;
  }

  .leader-division {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.02em;
  }

  .leader-name {
    font-size: clamp(1.22rem, 1.8vw, 1.42rem);
    font-weight: 800;
    line-height: 1.16;
    letter-spacing: -0.022em;
    color: var(--color-heading);
  }

  .leader-card--core .leader-name {
    font-size: 1.18rem;
  }

  .leader-role-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.3;
  }

  .leader-ign {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink-subtle);
  }

  .leader-bio {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-muted);
    max-width: none;
  }

  .leader-motto {
    margin: 0;
    padding: 0.55rem 0.9rem;
    border-left: 3px solid var(--brand-gold);
    background-color: var(--color-surface);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-ink);
  }

  :global(:root[data-theme='dark']) .leader-motto {
    background-color: rgba(11, 8, 36, 0.52);
  }

  .leader-meta {
    margin-top: auto;
    padding-top: 0.95rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 0.75rem;
  }

  .meta-role {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-heading);
  }

  .meta-role-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
  }

  .meta-tier {
    display: inline-flex;
    align-items: center;
    padding: 0.28rem 0.72rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-tag-online-bg);
    color: var(--color-tag-online-text);
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .leader-card--lead .meta-tier {
    background-color: var(--color-tag-offline-bg);
    color: var(--color-tag-offline-text);
  }

  .leadership-footnote {
    font-size: var(--text-sm);
    color: var(--color-ink-subtle);
  }

  @media (max-width: 960px) {
    .leaders-core-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .leaders-lead-grid,
    .leaders-core-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .leadership-summary {
      width: 100%;
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .leader-card {
      transition: border-color var(--dur-fast) ease;
    }

    .leader-card:hover {
      transform: none;
    }
  }
</style>
