---
import { communityInfo } from '../data/community';

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '/index.html';

const navLinks = [
  { href: '/', label: 'Home', active: isHome },
  { href: '/turnamen', label: 'Turnamen', active: currentPath.startsWith('/turnamen') },
  { href: '/kegiatan', label: 'Rekap', active: currentPath.startsWith('/kegiatan') },
];
---

<header class="site-header" data-header>
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Beranda Win Streak Party">
      <img
        class="brand-mark"
        src="/images/brand/wsp-logo-mark.png"
        alt=""
        width="40"
        height="33"
      />
      <span class="brand-name">{communityInfo.name}</span>
    </a>

    <nav class="nav-desktop" aria-label="Navigasi utama">
      <ul class="nav-list">
        {navLinks.map((item) => (
          <li>
            <a
              class={`nav-link${item.active ? ' is-current' : ''}`}
              href={item.href}
              aria-current={item.active ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button
        type="button"
        class="theme-toggle"
        aria-label="Ubah ke mode gelap"
        aria-pressed="false"
        title="Ganti tema terang atau gelap"
        data-theme-toggle
      >
        <svg class="icon-moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg class="icon-sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" />
          <line x1="12" y1="2.5" x2="12" y2="4.5" />
          <line x1="12" y1="19.5" x2="12" y2="21.5" />
          <line x1="4.93" y1="4.93" x2="6.34" y2="6.34" />
          <line x1="17.66" y1="17.66" x2="19.07" y2="19.07" />
          <line x1="2.5" y1="12" x2="4.5" y2="12" />
          <line x1="19.5" y1="12" x2="21.5" y2="12" />
          <line x1="4.93" y1="19.07" x2="6.34" y2="17.66" />
          <line x1="17.66" y1="6.34" x2="19.07" y2="4.93" />
        </svg>
      </button>

      <a class="btn btn-primary header-cta" href="/#gabung">Gabung Komunitas</a>

      <button
        type="button"
        class="menu-toggle"
        aria-label="Buka menu navigasi"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line class="line-top" x1="3" y1="7" x2="21" y2="7" />
          <line class="line-mid" x1="3" y1="12" x2="21" y2="12" />
          <line class="line-bot" x1="3" y1="17" x2="21" y2="17" />
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-drawer" id="mobile-nav" hidden data-mobile-drawer>
    <div class="wrap drawer-inner">
      <nav aria-label="Navigasi seluler">
        <ul class="drawer-list">
          {navLinks.map((item) => (
            <li>
              <a
                class={`drawer-link${item.active ? ' is-current' : ''}`}
                href={item.href}
                aria-current={item.active ? 'page' : undefined}
                data-drawer-link
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a class="btn btn-primary drawer-cta" href="/#gabung" data-drawer-link>Gabung Komunitas</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 90;
    background-color: var(--color-header-bg);
    border-bottom: 1px solid var(--color-header-border);
    transition:
      box-shadow var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  .site-header[data-scrolled='true'] {
    box-shadow: var(--color-header-shadow);
    border-bottom-color: rgba(21, 16, 66, 0.16);
  }

  :global(:root[data-theme='dark']) .site-header {
    --color-focus: var(--brand-indigo);
    box-shadow: var(--color-header-shadow);
  }

  .header-inner {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-mark {
    width: auto;
    height: 32px;
    object-fit: contain;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--color-header-ink);
    line-height: 1;
  }

  .nav-desktop {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.9rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-header-ink-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 8px;
    height: 2px;
    background-color: var(--brand-gold);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .nav-link.is-current {
    color: var(--color-header-ink);
  }

  .nav-link.is-current::after {
    transform: scaleX(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      color: var(--color-header-ink);
    }

    .nav-link:hover::after {
      transform: scaleX(1);
    }
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .theme-toggle,
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--color-border-strong);
    background-color: var(--color-surface);
    color: var(--color-header-ink);
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .menu-toggle {
    display: none;
    border-radius: var(--radius-sm);
  }

  .theme-toggle:active,
  .menu-toggle:active {
    transform: scale(0.95);
  }

  @media (hover: hover) and (pointer: fine) {
    .theme-toggle:hover,
    .menu-toggle:hover {
      border-color: var(--brand-indigo);
      color: var(--brand-indigo);
    }
  }

  .icon-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
    color: var(--brand-gold);
  }

  :global(:root[data-theme='dark']) .theme-toggle {
    background-color: var(--brand-indigo);
    border-color: var(--brand-indigo);
    color: var(--brand-gold);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(:root[data-theme='dark']) .theme-toggle:hover {
      background-color: var(--brand-indigo-deep);
      border-color: var(--brand-indigo-deep);
      color: var(--brand-gold);
    }
  }

  :global(:root[data-theme='dark']) .menu-toggle {
    background-color: #ffffff;
    border-color: rgba(27, 20, 100, 0.24);
    color: var(--brand-indigo);
  }

  :global(:root[data-theme='dark']) .header-cta,
  :global(:root[data-theme='dark']) .drawer-cta {
    background-color: var(--brand-indigo);
    color: var(--brand-chalk);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(:root[data-theme='dark']) .header-cta:hover,
    :global(:root[data-theme='dark']) .drawer-cta:hover {
      background-color: var(--brand-indigo-deep);
      color: var(--brand-chalk);
    }
  }

  /* Hamburger-to-X SVG morph */
  .menu-toggle line {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform var(--dur-base) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out);
  }

  .menu-toggle[aria-expanded='true'] .line-top {
    transform: translateY(5px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .line-mid {
    opacity: 0;
    transform: scaleX(0.4);
  }

  .menu-toggle[aria-expanded='true'] .line-bot {
    transform: translateY(-5px) rotate(-45deg);
  }

  .header-cta {
    min-height: 44px;
    padding: 0.65rem 1.2rem;
  }

  .mobile-drawer {
    border-top: 1px solid rgba(27, 20, 100, 0.12);
    background-color: var(--color-header-bg);
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  @starting-style {
    .mobile-drawer:not([hidden]) {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .mobile-drawer[hidden] {
    display: none;
  }

  .drawer-inner {
    padding-block: 1.25rem 1.75rem;
    display: grid;
    gap: 1.25rem;
  }

  .drawer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .drawer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    padding-block: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-header-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(27, 20, 100, 0.12);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .drawer-link.is-current {
    color: var(--brand-indigo-soft);
  }

  .drawer-cta {
    width: 100%;
  }

  @media (max-width: 860px) {
    .nav-desktop,
    .header-cta {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-drawer,
    .menu-toggle line,
    .nav-link::after {
      transition: opacity var(--dur-fast) ease, color var(--dur-fast) ease;
    }
  }
</style>

<script>
  const headerEl = document.querySelector<HTMLElement>('[data-header]');
  const toggleBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const drawer = document.querySelector<HTMLElement>('[data-mobile-drawer]');
  const drawerLinks = document.querySelectorAll<HTMLAnchorElement>('[data-drawer-link]');
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  // Elevasi header saat halaman digulir
  if (headerEl) {
    const syncScroll = () => {
      headerEl.dataset.scrolled = window.scrollY > 12 ? 'true' : 'false';
    };
    syncScroll();
    window.addEventListener('scroll', syncScroll, { passive: true });
  }

  // Kontrol tema terang / gelap dengan persistensi localStorage
  if (themeBtn) {
    const syncThemeUi = (theme: string) => {
      const isDark = theme === 'dark';
      themeBtn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
      themeBtn.setAttribute('aria-label', isDark ? 'Ubah ke mode terang' : 'Ubah ke mode gelap');
    };

    const currentTheme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    syncThemeUi(currentTheme);

    themeBtn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      syncThemeUi(next);
      try {
        localStorage.setItem('wsp-theme', next);
      } catch {
        // Abaikan jika penyimpanan browser dibatasi
      }
    });

    const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
    mediaQuery.addEventListener('change', (event) => {
      try {
        if (localStorage.getItem('wsp-theme')) return;
      } catch {
        return;
      }
      const next = event.matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      syncThemeUi(next);
    });
  }

  // Menu seluler
  if (toggleBtn && drawer) {
    const closeMenu = () => {
      drawer.hidden = true;
      toggleBtn.setAttribute('aria-expanded', 'false');
      toggleBtn.setAttribute('aria-label', 'Buka menu navigasi');
    };

    const openMenu = () => {
      drawer.hidden = false;
      toggleBtn.setAttribute('aria-expanded', 'true');
      toggleBtn.setAttribute('aria-label', 'Tutup menu navigasi');
    };

    toggleBtn.addEventListener('click', () => {
      const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isOpen) closeMenu();
      else openMenu();
    });

    drawerLinks.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('click', (event) => {
      if (!drawer.hidden && headerEl && !headerEl.contains(event.target as Node)) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !drawer.hidden) {
        closeMenu();
        toggleBtn.focus();
      }
    });
  }
</script>
