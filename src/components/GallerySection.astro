---
import { galleryPhotos } from '../data/community';
import Picture from './Picture.astro';

const sizeBySpan = {
  wide: '(max-width: 580px) 100vw, (max-width: 860px) 50vw, 58vw',
  narrow: '(max-width: 580px) 100vw, (max-width: 860px) 50vw, 42vw',
  half: '(max-width: 580px) 100vw, 50vw',
} as const;

const toWebp = (src: string) => (src.endsWith('.jpg') ? `${src.slice(0, -4)}.webp` : src);
---

<section class="gallery" id="galeri" aria-labelledby="gallery-title">
  <div class="wrap gallery-shell">
    <div class="gallery-head">
      <h2 id="gallery-title" class="gallery-heading">Dokumentasi momen kegiatan</h2>
      <p class="gallery-lead">
        Cuplikan suasana mabar, diskusi draft, turnamen mini, dan kopdar komunitas. Seluruh foto di bawah merupakan aset placeholder yang siap diganti dengan arsip asli Win Streak Party.
      </p>
    </div>

    <div class="gallery-grid">
      {galleryPhotos.map((photo, index) => (
        <button
          type="button"
          class={`gallery-tile span-${photo.span}`}
          aria-label={`Perbesar foto ${index + 1} dari ${galleryPhotos.length}: ${photo.label}`}
          data-lightbox-trigger={index}
          data-src={toWebp(photo.src)}
          data-fallback-src={photo.src}
          data-alt={photo.alt}
          data-label={photo.label}
        >
          <Picture
            src={photo.src}
            alt={photo.alt}
            sizes={sizeBySpan[photo.span]}
            loading="lazy"
          />
          <span class="tile-caption" aria-hidden="true">{photo.label}</span>
        </button>
      ))}
    </div>
  </div>

  <dialog class="lightbox" id="gallery-lightbox" aria-labelledby="lightbox-title-el">
    <div class="lightbox-frame">
      <div class="lightbox-bar">
        <div class="lightbox-meta">
          <span class="lightbox-counter" data-lightbox-counter>1 / {galleryPhotos.length}</span>
          <span class="lightbox-title" id="lightbox-title-el" data-lightbox-title>{galleryPhotos[0]?.label}</span>
        </div>
        <div class="lightbox-controls">
          <button type="button" class="lightbox-btn" data-lightbox-prev aria-label="Foto sebelumnya">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6" />
            </svg>
          </button>
          <button type="button" class="lightbox-btn" data-lightbox-next aria-label="Foto berikutnya">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </button>
          <button type="button" class="lightbox-btn lightbox-close" data-lightbox-close aria-label="Tutup pratinjau">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>
      </div>

      <div class="lightbox-img-wrap" data-lightbox-stage>
        <img
          src={toWebp(galleryPhotos[0]?.src ?? '')}
          alt={galleryPhotos[0]?.alt ?? ''}
          decoding="async"
          data-lightbox-img
        />
      </div>
    </div>
  </dialog>
</section>

<style>
  .gallery {
    padding-block: var(--section-py);
  }

  .gallery-shell {
    display: grid;
    gap: 2.25rem;
  }

  .gallery-head {
    display: grid;
    grid-template-columns: minmax(0, 5.5fr) minmax(0, 6.5fr);
    gap: 1.25rem 3rem;
    align-items: end;
  }

  .gallery-heading {
    font-size: var(--text-h2);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.028em;
    color: var(--color-heading);
  }

  .gallery-lead {
    color: var(--color-ink-muted);
    max-width: 54ch;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .gallery-tile {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface-muted);
    cursor: pointer;
    height: clamp(240px, 26vw, 350px);
    text-align: left;
  }

  .span-wide {
    grid-column: span 7;
  }

  .span-narrow {
    grid-column: span 5;
  }

  .span-half {
    grid-column: span 6;
  }

  .gallery-tile :global(img) {
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .tile-caption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 2.25rem 1.15rem 0.9rem;
    background: linear-gradient(to top, rgba(11, 8, 36, 0.84) 0%, rgba(11, 8, 36, 0) 100%);
    color: var(--brand-chalk);
    font-size: var(--text-sm);
    font-weight: 600;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
    pointer-events: none;
  }

  .gallery-tile:focus-visible .tile-caption {
    opacity: 1;
    transform: translateY(0);
  }

  @media (hover: hover) and (pointer: fine) {
    .gallery-tile:hover :global(img) {
      transform: scale(1.03);
    }

    .gallery-tile:hover .tile-caption {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Lightbox Dialog */
  .lightbox {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: min(960px, calc(100vw - 2rem));
    width: 100%;
    overflow: visible;
    opacity: 0;
    transform: scale(0.96);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      overlay var(--dur-base) allow-discrete,
      display var(--dur-base) allow-discrete;
  }

  .lightbox[open] {
    opacity: 1;
    transform: scale(1);
  }

  @starting-style {
    .lightbox[open] {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  .lightbox::backdrop {
    background-color: var(--color-scrim);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition:
      opacity var(--dur-base) var(--ease-out),
      overlay var(--dur-base) allow-discrete,
      display var(--dur-base) allow-discrete;
  }

  .lightbox[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    .lightbox[open]::backdrop {
      opacity: 0;
    }
  }

  .lightbox-frame {
    background-color: var(--brand-indigo-deep);
    color: var(--color-ink-on-dark);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-dark);
    border: 1px solid var(--color-border-dark);
  }

  .lightbox-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.15rem;
    border-bottom: 1px solid var(--color-border-dark);
  }

  .lightbox-meta {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-width: 0;
  }

  .lightbox-counter {
    font-size: var(--text-xs);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--brand-gold);
    flex-shrink: 0;
  }

  .lightbox-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    color: var(--color-ink-on-dark);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lightbox-controls {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-shrink: 0;
  }

  .lightbox-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-dark);
    background-color: var(--color-surface-dark-subtle);
    color: var(--color-ink-on-dark);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .lightbox-btn:active {
    transform: scale(0.95);
  }

  @media (hover: hover) and (pointer: fine) {
    .lightbox-btn:hover {
      background-color: var(--color-surface-dark-hover);
    }
  }

  .lightbox-close {
    background-color: var(--brand-gold);
    border-color: var(--brand-gold);
    color: var(--brand-indigo-deep);
  }

  @media (hover: hover) and (pointer: fine) {
    .lightbox-close:hover {
      background-color: var(--brand-gold-hover);
    }
  }

  .lightbox-img-wrap {
    background-color: var(--brand-indigo-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: pan-y;
    user-select: none;
  }

  .lightbox-img-wrap img {
    width: 100%;
    max-height: 75dvh;
    object-fit: contain;
    transition: opacity var(--dur-fast) ease;
  }

  @media (max-width: 860px) {
    .gallery-head {
      grid-template-columns: minmax(0, 1fr);
    }

    .span-wide,
    .span-narrow,
    .span-half {
      grid-column: span 6;
    }
  }

  @media (max-width: 580px) {
    .gallery-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .span-wide,
    .span-narrow,
    .span-half {
      grid-column: span 1;
      height: 240px;
    }

    .tile-caption {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-tile :global(img),
    .tile-caption,
    .lightbox,
    .lightbox-btn {
      transform: none;
      transition: opacity var(--dur-fast) ease;
    }
  }
</style>

<script>
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]'));
  const dialog = document.getElementById('gallery-lightbox') as HTMLDialogElement | null;
  const imgEl = dialog?.querySelector<HTMLImageElement>('[data-lightbox-img]');
  const titleEl = dialog?.querySelector<HTMLElement>('[data-lightbox-title]');
  const counterEl = dialog?.querySelector<HTMLElement>('[data-lightbox-counter]');
  const stageEl = dialog?.querySelector<HTMLElement>('[data-lightbox-stage]');
  const prevBtn = dialog?.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
  const nextBtn = dialog?.querySelector<HTMLButtonElement>('[data-lightbox-next]');
  const closeBtn = dialog?.querySelector<HTMLButtonElement>('[data-lightbox-close]');

  let currentIndex = 0;

  const preloadAdjacent = (index: number) => {
    const neighbors = [
      (index + 1) % triggers.length,
      (index - 1 + triggers.length) % triggers.length,
    ];
    neighbors.forEach((nIdx) => {
      const src = triggers[nIdx]?.dataset.src;
      if (src) {
        const pre = new Image();
        pre.src = src;
      }
    });
  };

  const showImage = (index: number) => {
    const safeIndex = (index + triggers.length) % triggers.length;
    currentIndex = safeIndex;
    const item = triggers[safeIndex];
    if (!item || !imgEl || !titleEl) return;

    const webpSrc = item.dataset.src || '';
    const fallbackSrc = item.dataset.fallbackSrc || webpSrc;
    imgEl.onerror = () => {
      if (imgEl.src !== fallbackSrc) {
        imgEl.onerror = null;
        imgEl.src = fallbackSrc;
      }
    };
    imgEl.src = webpSrc;
    imgEl.alt = item.dataset.alt || '';
    titleEl.textContent = item.dataset.label || '';
    if (counterEl) {
      counterEl.textContent = `${safeIndex + 1} / ${triggers.length}`;
    }
    preloadAdjacent(safeIndex);
  };

  if (dialog && triggers.length > 0) {
    triggers.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        showImage(idx);
        dialog.showModal();
      });
    });

    prevBtn?.addEventListener('click', () => showImage(currentIndex - 1));
    nextBtn?.addEventListener('click', () => showImage(currentIndex + 1));
    closeBtn?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        showImage(currentIndex - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        showImage(currentIndex + 1);
      }
    });

    // Dukungan geser sentuh (swipe) pada pratinjau foto
    if (stageEl) {
      let startX = 0;
      let startY = 0;
      let startTime = 0;
      let activePointerId: number | null = null;

      const resetSwipe = () => {
        activePointerId = null;
      };

      stageEl.addEventListener('pointerdown', (event) => {
        if (activePointerId !== null) return;
        activePointerId = event.pointerId;
        startX = event.clientX;
        startY = event.clientY;
        startTime = performance.now();
      });

      stageEl.addEventListener('pointerup', (event) => {
        if (event.pointerId !== activePointerId) return;
        const dx = event.clientX - startX;
        const dy = event.clientY - startY;
        const elapsed = Math.max(1, performance.now() - startTime);
        const velocity = Math.abs(dx) / elapsed;
        resetSwipe();

        if (Math.abs(dx) > Math.abs(dy) && (Math.abs(dx) >= 48 || velocity > 0.25)) {
          if (dx < 0) showImage(currentIndex + 1);
          else showImage(currentIndex - 1);
        }
      });

      stageEl.addEventListener('pointercancel', resetSwipe);
      stageEl.addEventListener('lostpointercapture', resetSwipe);
    }
  }
</script>
