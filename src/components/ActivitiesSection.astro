---
import { activities } from '../data/community';
---

<section class="activities band-dark" id="kegiatan" aria-labelledby="activities-title">
  <div class="wrap activities-shell">
    <div class="activities-head">
      <h2 id="activities-title" class="activities-heading">
        Kegiatan yang bikin lobi selalu hidup
      </h2>

      <div class="activity-tabs" role="tablist" aria-label="Pilihan program kegiatan komunitas">
        {activities.map((item, idx) => (
          <button
            type="button"
            role="tab"
            class="tab-btn"
            id={`tab-${item.id}`}
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-controls={`panel-${item.id}`}
            tabindex={idx === 0 ? '0' : '-1'}
            data-activity-tab={item.id}
          >
            {item.tabLabel}
          </button>
        ))}
      </div>
    </div>

    <div class="panels-stage">
      {activities.map((item, idx) => (
        <div
          role="tabpanel"
          class="activity-panel"
          id={`panel-${item.id}`}
          aria-labelledby={`tab-${item.id}`}
          hidden={idx !== 0}
          data-activity-panel={item.id}
        >
          <div class="panel-media">
            <img
              src={item.image}
              alt={item.imageAlt}
              width="1600"
              height="1067"
              loading={idx === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>

          <div class="panel-content">
            <h3 class="panel-title">{item.title}</h3>
            <p class="panel-summary">{item.summary}</p>

            <dl class="panel-details">
              <div class="detail-row">
                <dt>Format sesi</dt>
                <dd>{item.format}</dd>
              </div>
              <div class="detail-row">
                <dt>Divisi terkait</dt>
                <dd>{item.games.join(', ')}</dd>
              </div>
              <div class="detail-row">
                <dt>Cara ikut</dt>
                <dd>{item.howToJoin}</dd>
              </div>
            </dl>

            <div class="panel-actions">
              <a class="btn btn-gold" href="#gabung">Ikut sesi berikutnya</a>
              <a class="btn btn-secondary-dark" href="#jadwal">Cek jam main</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .activities {
    background-color: var(--color-indigo);
    color: var(--color-ink-on-dark);
    padding-block: var(--section-py);
  }

  .activities-shell {
    display: grid;
    gap: clamp(2rem, 3.8vw, 3rem);
  }

  .activities-head {
    display: grid;
    gap: 1.75rem;
  }

  .activities-heading {
    font-size: var(--text-h2);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.028em;
    color: var(--color-ink-on-dark);
    max-width: 20ch;
  }

  .activity-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-bottom: 0.25rem;
  }

  .tab-btn {
    min-height: 44px;
    padding: 0.65rem 1.2rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--color-border-dark);
    background-color: var(--color-surface-dark-subtle);
    color: var(--color-ink-on-dark);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .tab-btn:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .tab-btn:hover:not([aria-selected='true']) {
      background-color: var(--color-surface-dark-hover);
      border-color: var(--color-border-dark-strong);
    }
  }

  .tab-btn[aria-selected='true'] {
    background-color: var(--color-gold);
    border-color: var(--color-gold);
    color: var(--color-indigo-deep);
    font-weight: 700;
  }

  .activity-panel {
    display: grid;
    grid-template-columns: minmax(0, 6.7fr) minmax(0, 5.3fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: center;
  }

  .activity-panel[hidden] {
    display: none;
  }

  @keyframes panelSwap {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .activity-panel.is-switching {
    animation: panelSwap var(--dur-base) var(--ease-out) both;
  }

  .panel-media {
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--color-indigo-deep);
    box-shadow: var(--shadow-dark);
    aspect-ratio: 16 / 10;
    min-width: 0;
  }

  .panel-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .panel-content {
    display: grid;
    gap: 1.35rem;
    min-width: 0;
  }

  .panel-title {
    font-size: clamp(1.5rem, 2.3vw, 2rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.024em;
    color: var(--color-ink-on-dark);
  }

  .panel-summary {
    color: var(--color-ink-on-dark-muted);
    font-size: var(--text-base);
  }

  .panel-details {
    margin: 0;
    border-top: 1px solid var(--color-border-dark);
    display: grid;
  }

  .detail-row {
    display: grid;
    grid-template-columns: minmax(0, 125px) minmax(0, 1fr);
    gap: 0.75rem 1.25rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-border-dark);
    align-items: baseline;
  }

  .detail-row dt {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-gold);
  }

  .detail-row dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-on-dark);
  }

  .panel-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    padding-top: 0.4rem;
  }

  @media (max-width: 960px) {
    .activity-panel {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 540px) {
    .detail-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }

    .panel-actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    .panel-actions .btn {
      width: 100%;
    }
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-activity-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-activity-panel]'));

  const activateTab = (targetId: string, shouldFocus = false) => {
    tabs.forEach((tab) => {
      const selected = tab.dataset.activityTab === targetId;
      tab.setAttribute('aria-selected', selected ? 'true' : 'false');
      tab.tabIndex = selected ? 0 : -1;
      if (selected && shouldFocus) tab.focus();
    });

    panels.forEach((panel) => {
      const match = panel.dataset.activityPanel === targetId;
      panel.hidden = !match;
      panel.classList.remove('is-switching');
      if (match) {
        void panel.offsetWidth;
        panel.classList.add('is-switching');
      }
    });
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => {
      if (tab.dataset.activityTab) {
        activateTab(tab.dataset.activityTab);
      }
    });

    tab.addEventListener('keydown', (event) => {
      let nextIndex = -1;
      if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
      if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
      if (event.key === 'Home') nextIndex = 0;
      if (event.key === 'End') nextIndex = tabs.length - 1;

      if (nextIndex !== -1) {
        event.preventDefault();
        const nextTab = tabs[nextIndex];
        if (nextTab?.dataset.activityTab) {
          activateTab(nextTab.dataset.activityTab, true);
        }
      }
    });
  });
</script>
