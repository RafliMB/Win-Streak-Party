---
import { communityInfo } from '../data/community';
---

<footer class="site-footer">
  <div class="wrap footer-main">
    <div class="footer-brand">
      <a class="footer-logo" href="/" aria-label="Beranda Win Streak Party">
        <span class="footer-logo-badge">
          <img
            src="/images/brand/wsp-logo-mark.png"
            alt=""
            width="36"
            height="29"
            loading="lazy"
            decoding="async"
          />
        </span>
        <span class="footer-wordmark">{communityInfo.name}</span>
      </a>
      <p class="footer-slogan">{communityInfo.slogan}</p>
      <p class="footer-tagline">{communityInfo.tagline}</p>
    </div>

    <div class="footer-col">
      <h2 class="footer-col-title">Kanal komunitas</h2>
      <ul class="footer-links">
        <li>
          <a class="channel-link" href={communityInfo.channels.discordUrl} target="_blank" rel="noopener noreferrer">
            <span class="channel-link-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
              </svg>
            </span>
            <span>Discord</span>
          </a>
        </li>
        <li>
          <a class="channel-link" href={communityInfo.channels.whatsappUrl} target="_blank" rel="noopener noreferrer">
            <span class="channel-link-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.031 2C6.506 2 2.01 6.495 2.01 12.02c0 1.766.462 3.49 1.338 5.012L2 22l5.102-1.338a9.97 9.97 0 0 0 4.929 1.304h.004c5.524 0 10.02-4.496 10.02-10.02A9.96 9.96 0 0 0 19.12 4.94 9.954 9.954 0 0 0 12.031 2zm5.847 14.18c-.248.698-1.44 1.334-2.01 1.418-.517.077-1.186.11-1.914-.12-.442-.14-1.01-.328-1.737-.642-3.058-1.32-5.054-4.396-5.207-4.6-.153-.204-1.242-1.652-1.242-3.152 0-1.5.786-2.238 1.064-2.543.279-.304.609-.38.812-.38.203 0 .406.002.584.011.187.009.438-.071.685.523.248.595.843 2.054.917 2.203.074.15.124.324.025.523-.099.199-.149.324-.298.498-.149.174-.313.389-.447.523-.149.149-.304.31-.13.608.174.298.773 1.275 1.66 2.066 1.14 1.016 2.101 1.331 2.4 1.48.298.15.472.125.646-.075.174-.199.744-.869.943-1.167.199-.298.397-.248.67-.149.274.1 1.737.82 2.035.969.298.149.497.224.571.348.075.125.075.722-.173 1.42z" />
              </svg>
            </span>
            <span>WhatsApp</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>© {new Date().getFullYear()} {communityInfo.name}. Profil komunitas Mobile Legends.</p>
    <p class="footer-note">Foto kegiatan menggunakan aset placeholder dummy dan siap diganti dengan dokumentasi asli.</p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-band-deep);
    color: var(--color-ink-on-dark);
    border-top: 1px solid var(--color-border-dark);
    padding-top: clamp(3.5rem, 6vw, 5rem);
    padding-bottom: 2.25rem;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 2.5rem 3.5rem;
    align-items: start;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-border-dark);
  }

  .footer-brand {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    width: fit-content;
  }

  .footer-logo-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.55rem;
    border-radius: var(--radius-sm);
    background-color: var(--brand-surface-white);
    flex-shrink: 0;
  }

  .footer-logo-badge img {
    height: 28px;
    width: auto;
  }

  .footer-wordmark {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--color-ink-on-dark);
  }

  .footer-slogan {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.018em;
    color: var(--brand-gold);
  }

  .footer-tagline {
    color: var(--color-ink-on-dark-muted);
    font-size: var(--text-sm);
    max-width: 40ch;
  }

  .footer-col {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .footer-col-title {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--brand-gold);
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .channel-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-on-dark-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .channel-link-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface-dark-subtle);
    border: 1px solid var(--color-border-dark);
    color: var(--brand-gold);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .channel-link:hover {
      color: var(--color-ink-on-dark);
    }

    .channel-link:hover .channel-link-icon {
      background-color: var(--brand-gold);
      border-color: var(--brand-gold);
      color: var(--brand-indigo-deep);
    }
  }

  .footer-bottom {
    padding-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.65rem 2rem;
    font-size: var(--text-xs);
    color: var(--color-ink-on-dark-muted);
  }

  .footer-note {
    max-width: none;
  }

  @media (max-width: 860px) {
    .footer-main {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }
</style>
