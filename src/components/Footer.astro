---
import { communityInfo } from '../data/community';
---

<footer class="site-footer">
  <div class="wrap footer-main">
    <div class="footer-brand">
      <a class="footer-logo" href="#beranda" aria-label="Kembali ke atas">
        <img
          src="/images/brand/wsp-logo-light.png"
          alt=""
          width="46"
          height="38"
        />
        <span class="footer-wordmark">{communityInfo.name}</span>
      </a>
      <p class="footer-tagline">{communityInfo.tagline}</p>
    </div>

    <div class="footer-col">
      <h2 class="footer-col-title">Navigasi</h2>
      <ul class="footer-links">
        <li><a href="#tentang">Tentang komunitas</a></li>
        <li><a href="#kegiatan">Program kegiatan</a></li>
        <li><a href="#jadwal">Jadwal rutin</a></li>
        <li><a href="#galeri">Galeri kegiatan</a></li>
        <li><a href="#gabung">Daftar member</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h2 class="footer-col-title">Kanal komunitas</h2>
      <ul class="footer-links">
        <li>
          <a href={communityInfo.channels.discordUrl} target="_blank" rel="noopener noreferrer">
            Discord ({communityInfo.channels.discordDisplay})
          </a>
        </li>
        <li>
          <a href={communityInfo.channels.whatsappUrl} target="_blank" rel="noopener noreferrer">
            {communityInfo.channels.whatsappDisplay}
          </a>
        </li>
        <li>
          <a href={communityInfo.channels.instagramUrl} target="_blank" rel="noopener noreferrer">
            Instagram ({communityInfo.channels.instagramDisplay})
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>© {new Date().getFullYear()} {communityInfo.name}. Profil komunitas gaming dan esports.</p>
    <p class="footer-note">Foto kegiatan menggunakan aset placeholder dummy dan siap diganti dengan dokumentasi asli.</p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-indigo-deep);
    color: var(--color-ink-on-dark);
    padding-top: clamp(3.5rem, 6vw, 5rem);
    padding-bottom: 2.25rem;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 2.5rem 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-border-dark);
  }

  .footer-brand {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    width: fit-content;
  }

  .footer-logo img {
    height: 36px;
    width: auto;
  }

  .footer-wordmark {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--color-ink-on-dark);
  }

  .footer-tagline {
    color: var(--color-ink-on-dark-muted);
    font-size: var(--text-sm);
    max-width: 38ch;
  }

  .footer-col {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .footer-col-title {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-gold);
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .footer-links a {
    display: inline-block;
    padding-block: 0.2rem;
    font-size: var(--text-sm);
    color: var(--color-ink-on-dark-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-links a:hover {
      color: var(--color-gold);
    }
  }

  .footer-bottom {
    padding-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.65rem 2rem;
    font-size: var(--text-xs);
    color: var(--color-ink-on-dark-muted);
  }

  .footer-note {
    max-width: none;
  }

  @media (max-width: 860px) {
    .footer-main {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }
</style>
