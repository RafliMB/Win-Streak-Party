---
import { communityInfo } from '../data/community';
import Picture from './Picture.astro';
---

<section class="hero" id="beranda" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy hero-enter">
      <h1 id="hero-title" class="hero-title">{communityInfo.heroHeading}</h1>
      <p class="hero-slogan">{communityInfo.slogan}</p>
      <p class="hero-lead">{communityInfo.heroLead}</p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="#gabung">Gabung Komunitas</a>
        <a class="btn btn-secondary" href="#jadwal">Lihat Jadwal Mabar</a>
      </div>
    </div>

    <div class="hero-media hero-enter-delay">
      <div class="hero-frame">
        <Picture
          src="/images/activities/hero-mabar.jpg"
          alt="Anggota Win Streak Party bermain game mobile bersama di meja kafe sambil berdiskusi dan tertawa"
          sizes="(max-width: 960px) 100vw, 54vw"
          loading="eager"
          fetchpriority="high"
          objectPosition="center 35%"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--header-h));
    padding-block: clamp(2.5rem, 4.8vw, 4rem);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 5.5fr) minmax(0, 6.5fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 3.75rem);
  }

  .hero-copy {
    display: grid;
    gap: 1.45rem;
    align-content: center;
    min-width: 0;
  }

  .hero-title {
    font-size: var(--text-h1);
    font-weight: 800;
    line-height: 1.03;
    letter-spacing: -0.032em;
    color: var(--color-heading);
  }

  .hero-slogan {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-accent);
  }

  .hero-lead {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-ink-muted);
    max-width: 44ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    padding-top: 0.35rem;
  }

  .hero-media {
    min-width: 0;
  }

  .hero-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background-color: var(--brand-indigo);
    box-shadow: var(--shadow-lift);
    aspect-ratio: 3 / 2;
  }

  .hero-frame::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 6px;
    background-color: var(--brand-gold);
    pointer-events: none;
  }

  @media (max-width: 960px) {
    .hero {
      min-height: auto;
      display: block;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .hero-lead {
      max-width: 58ch;
    }
  }

  @media (max-width: 540px) {
    .hero-actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-actions .btn {
      width: 100%;
    }
  }
</style>
