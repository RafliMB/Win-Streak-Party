---
import { communityInfo, formPlaystyles, formRoles, formTiers } from '../data/community';
import RoleIcon from './RoleIcon.astro';
---

<section
  class="join"
  id="gabung"
  aria-labelledby="join-title"
  data-site-domain={communityInfo.domain}
  data-slogan={communityInfo.slogan}
>
  <p class="sr-only" aria-live="polite" id="join-live-status"></p>

  <div class="wrap join-grid">
    <div class="join-channels">
      <div class="join-intro">
        <h2 id="join-title" class="join-heading">Masuk lobi dan kenalan dengan skuad</h2>
        <p class="join-lead">
          Kamu bisa langsung bergabung ke server Discord atau grup WhatsApp kami, atau isi formulir singkat di samping agar biodatamu otomatis masuk ke channel Discord sekaligus membuat kartu member PNG.
        </p>
      </div>

      <div class="channel-stack">
        <div class="channel-item channel-discord band-dark">
          <div class="channel-top">
            <span class="channel-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
              </svg>
            </span>
            <div>
              <h3 class="channel-title">Server Discord</h3>
              <p class="channel-desc">Kanal voice push rank, antrean party 5-stack, dan info scrim harian.</p>
            </div>
          </div>

          <div class="channel-actions">
            <a
              class="btn btn-gold"
              href={communityInfo.channels.discordUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Masuk Discord
            </a>
            <button
              type="button"
              class="btn btn-secondary-dark"
              data-copy-text={communityInfo.channels.discordDisplay}
            >
              Salin tautan
            </button>
          </div>
        </div>

        <div class="channel-item channel-surface">
          <div class="channel-top">
            <span class="channel-icon channel-icon-light" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
              </svg>
            </span>
            <div>
              <h3 class="channel-title">Grup WhatsApp</h3>
              <p class="channel-desc">Pengumuman cepat jadwal mabar, pendaftaran turnamen, dan absen nobar MPL.</p>
            </div>
          </div>

          <div class="channel-actions">
            <a
              class="btn btn-primary"
              href={communityInfo.channels.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Gabung WhatsApp
            </a>
            <a
              class="btn btn-secondary"
              href={communityInfo.channels.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Instagram {communityInfo.channels.instagramDisplay}
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="join-form-box">
      <h3 class="form-heading">Formulir pendaftaran member</h3>
      <p class="form-sub">
        Isi data singkat untuk mengirim biodata otomatis ke channel Discord Win Streak Party sekaligus membuat kartu perkenalan member.
      </p>

      <form class="member-form" id="member-form" novalidate>
        <div class="hp-field" aria-hidden="true">
          <label for="member-website">Situs web</label>
          <input id="member-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div class="field-group">
          <label for="member-name" class="field-label">Nickname in-game atau ID Mobile Legends</label>
          <input
            id="member-name"
            name="nickname"
            type="text"
            class="field-input"
            placeholder="Contoh: RakaWSP / 12345678 (1234)"
            autocomplete="nickname"
            required
            aria-describedby="err-name"
          />
          <p class="field-error" id="err-name" role="alert" hidden></p>
        </div>

        <div class="field-group">
          <label for="member-contact" class="field-label">Nomor WhatsApp atau username Discord</label>
          <input
            id="member-contact"
            name="contact"
            type="text"
            class="field-input"
            placeholder="Contoh: @raka.gg atau 08xx-xxxx-xxxx"
            autocomplete="tel"
            required
            aria-describedby="err-contact"
          />
          <p class="field-error" id="err-contact" role="alert" hidden></p>
        </div>

        <fieldset class="field-group field-set">
          <legend class="field-label">Role utama di Mobile Legends</legend>
          <div class="game-checks">
            {formRoles.map((role, idx) => (
              <label class="game-check">
                <input
                  type="checkbox"
                  name="roles"
                  value={role}
                  checked={idx === 0}
                />
                <span class="check-role-icon">
                  <RoleIcon role={role} size={16} />
                </span>
                <span>{role}</span>
              </label>
            ))}
          </div>
          <p class="field-error" id="err-roles" role="alert" hidden></p>
        </fieldset>

        <div class="field-row-two">
          <div class="field-group">
            <label for="member-tier" class="field-label">Tier saat ini</label>
            <select id="member-tier" name="tier" class="field-input field-select">
              {formTiers.map((tier) => (
                <option value={tier}>{tier}</option>
              ))}
            </select>
          </div>

          <div class="field-group">
            <label for="member-style" class="field-label">Fokus kegiatan yang dicari</label>
            <select id="member-style" name="playstyle" class="field-input field-select">
              {formPlaystyles.map((style) => (
                <option value={style}>{style}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="field-group">
          <label for="member-note" class="field-label">Hero andalan atau catatan singkat (opsional)</label>
          <textarea
            id="member-note"
            name="note"
            rows="3"
            maxlength="300"
            class="field-input field-textarea"
            placeholder="Misalnya: hero comfort Arlott & Chou, biasa aktif push rank malam setelah jam 20.00 WIB."
          ></textarea>
        </div>

        <p class="field-error form-alert" id="err-form" role="alert" hidden></p>

        <div class="form-footer">
          <button type="submit" class="btn btn-primary submit-btn" data-submit-btn>
            Kirim ke Discord &amp; buat kartu member
          </button>
          <p class="form-hint">
            Biodata dikirim otomatis ke channel pendaftaran Discord komunitas sekaligus menghasilkan kartu member PNG siap unduh.
          </p>
        </div>
      </form>

      <div class="form-success" id="form-success" hidden tabindex="-1">
        <div class="success-head">
          <h4 class="success-title" id="success-title">Biodata terkirim otomatis ke Discord</h4>
          <p class="success-desc" id="success-desc">
            Data pendaftaranmu sudah masuk ke channel Discord Win Streak Party. Unduh kartu member di bawah atau langsung gabung ke grup WhatsApp dan Discord.
          </p>
        </div>

        <div class="success-split">
          <div class="card-preview-col">
            <canvas
              id="member-card-canvas"
              class="member-card-canvas"
              width="1080"
              height="1080"
              aria-label="Pratinjau kartu perkenalan member Win Streak Party"
            ></canvas>
            <button type="button" class="btn btn-gold download-card-btn" id="download-card-btn">
              Unduh kartu member (.png)
            </button>
          </div>

          <div class="summary-col">
            <pre class="summary-preview" id="summary-preview"></pre>
            <div class="success-actions">
              <a
                class="btn btn-primary"
                href={communityInfo.channels.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Gabung Grup WhatsApp
              </a>
              <a
                class="btn btn-secondary"
                href={communityInfo.channels.discordUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Masuk Discord
              </a>
              <button type="button" class="btn btn-secondary" id="copy-summary-btn">
                Salin biodata
              </button>
              <button type="button" class="btn btn-secondary" id="reset-form-btn">
                Isi ulang
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .join {
    padding-block: var(--section-py);
    border-top: 1px solid var(--color-border);
  }

  .join-grid {
    display: grid;
    grid-template-columns: minmax(0, 5.2fr) minmax(0, 6.8fr);
    gap: clamp(2rem, 4.5vw, 4.25rem);
    align-items: start;
  }

  .join-channels {
    display: grid;
    gap: 1.75rem;
    min-width: 0;
  }

  .join-intro {
    display: grid;
    gap: 0.9rem;
  }

  .join-heading {
    font-size: var(--text-h2);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.028em;
    color: var(--color-heading);
  }

  .join-lead {
    color: var(--color-ink-muted);
  }

  .channel-stack {
    display: grid;
    gap: 1.15rem;
  }

  .channel-item {
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: grid;
    gap: 1.35rem;
  }

  .channel-discord {
    background-color: var(--color-band-bg);
    color: var(--color-ink-on-dark);
    border: 1px solid var(--color-border-dark);
  }

  .channel-surface {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-strong);
  }

  .channel-top {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .channel-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--brand-gold);
    color: var(--brand-indigo-deep);
  }

  .channel-icon-light {
    background-color: var(--color-surface-tint);
    color: var(--color-accent);
  }

  .channel-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    color: inherit;
    margin-bottom: 0.3rem;
  }

  .channel-discord .channel-desc {
    color: var(--color-ink-on-dark-muted);
    font-size: var(--text-sm);
  }

  .channel-surface .channel-desc {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .channel-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  /* Form Box — deklarasi elevasi tunggal (border tegas tanpa ghost shadow) */
  .join-form-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3.2vw, 2.4rem);
    min-width: 0;
  }

  .form-heading {
    font-size: var(--text-h3);
    font-weight: 800;
    color: var(--color-heading);
    margin-bottom: 0.45rem;
  }

  .form-sub {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    margin-bottom: 1.65rem;
  }

  .member-form {
    display: grid;
    gap: 1.25rem;
  }

  .member-form[hidden] {
    display: none;
  }

  .field-group {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
  }

  .field-row-two {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem;
  }

  .field-set {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .field-label {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-ink);
  }

  .field-input {
    width: 100%;
    min-height: 48px;
    padding: 0.72rem 0.95rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--color-border-strong);
    background-color: var(--color-canvas);
    color: var(--color-ink);
    font-size: var(--text-base);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .field-input::placeholder {
    color: var(--color-ink-subtle);
  }

  .field-input:focus {
    background-color: var(--color-surface);
    border-color: var(--color-accent);
  }

  .field-input[aria-invalid='true'] {
    border-color: var(--color-error);
    background-color: var(--color-error-bg);
  }

  .field-textarea {
    min-height: 96px;
    resize: vertical;
    line-height: 1.5;
  }

  .game-checks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding-top: 0.2rem;
  }

  .game-check {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    min-height: 44px;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--color-border-strong);
    background-color: var(--color-canvas);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .game-check input {
    accent-color: var(--color-accent);
    width: 16px;
    height: 16px;
    margin: 0;
  }

  .check-role-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .game-check:has(input:checked) {
    background-color: var(--color-surface-tint);
    border-color: var(--color-accent);
    color: var(--color-heading);
  }

  .game-check:has(input:checked) .check-role-icon {
    color: var(--color-accent);
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    pointer-events: none;
  }

  .field-error {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-error);
  }

  .form-alert {
    padding: 0.75rem 0.95rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-error-bg);
    border: 1px solid var(--color-error-border);
    font-size: var(--text-sm);
  }

  .field-error[hidden] {
    display: none;
  }

  .form-footer {
    display: grid;
    gap: 0.75rem;
    padding-top: 0.35rem;
  }

  .submit-btn {
    width: fit-content;
  }

  .form-hint {
    font-size: var(--text-xs);
    color: var(--color-ink-subtle);
  }

  .form-success {
    display: grid;
    gap: 1.35rem;
  }

  .form-success[hidden] {
    display: none;
  }

  .success-head {
    display: grid;
    gap: 0.4rem;
  }

  .success-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--color-success);
  }

  .success-title.is-warning {
    color: var(--color-heading);
  }

  .success-desc {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .success-split {
    display: grid;
    grid-template-columns: minmax(0, 240px) minmax(0, 1fr);
    gap: 1.35rem;
    align-items: start;
  }

  .card-preview-col {
    display: grid;
    gap: 0.75rem;
  }

  .member-card-canvas {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    display: block;
  }

  .download-card-btn {
    width: 100%;
  }

  .summary-col {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .summary-preview {
    margin: 0;
    padding: 1rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-border-strong);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--color-ink);
  }

  .success-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  @media (max-width: 960px) {
    .join-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .success-split {
      grid-template-columns: minmax(0, 1fr);
    }

    .member-card-canvas {
      max-width: 280px;
    }
  }

  @media (max-width: 540px) {
    .field-row-two {
      grid-template-columns: minmax(0, 1fr);
    }

    .channel-actions,
    .success-actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    .channel-actions .btn,
    .submit-btn,
    .success-actions .btn {
      width: 100%;
    }
  }
</style>

<script>
  const liveStatusEl = document.getElementById('join-live-status');
  const announce = (msg: string) => {
    if (liveStatusEl) liveStatusEl.textContent = msg;
  };

  // Salin tautan cepat di kanal Discord
  document.querySelectorAll<HTMLButtonElement>('[data-copy-text]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copyText || '';
      const original = btn.textContent || 'Salin tautan';
      try {
        await navigator.clipboard.writeText(value);
        btn.textContent = 'Tersalin';
        announce(`Tautan ${value} tersalin ke papan klip.`);
      } catch {
        btn.textContent = value;
        announce(`Tautan ditampilkan: ${value}`);
      }
      window.setTimeout(() => {
        btn.textContent = original;
      }, 2200);
    });
  });

  const joinSection = document.getElementById('gabung');
  const siteDomain = joinSection?.dataset.siteDomain || 'winstreakparty.my.id';
  const siteSlogan = joinSection?.dataset.slogan || 'Permabaran yang mantap';

  const form = document.getElementById('member-form') as HTMLFormElement | null;
  const submitBtn = form?.querySelector<HTMLButtonElement>('[data-submit-btn]') ?? null;
  const errFormEl = document.getElementById('err-form') as HTMLElement | null;
  const successBox = document.getElementById('form-success') as HTMLElement | null;
  const successTitleEl = document.getElementById('success-title') as HTMLElement | null;
  const successDescEl = document.getElementById('success-desc') as HTMLElement | null;
  const previewEl = document.getElementById('summary-preview') as HTMLElement | null;
  const copySummaryBtn = document.getElementById('copy-summary-btn') as HTMLButtonElement | null;
  const resetFormBtn = document.getElementById('reset-form-btn') as HTMLButtonElement | null;
  const downloadCardBtn = document.getElementById('download-card-btn') as HTMLButtonElement | null;
  const canvas = document.getElementById('member-card-canvas') as HTMLCanvasElement | null;

  const setFieldError = (inputId: string, errorId: string, message: string) => {
    const input = document.getElementById(inputId);
    const err = document.getElementById(errorId);
    if (input) {
      if (message) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
    }
    if (err) {
      err.textContent = message;
      err.hidden = !message;
    }
  };

  const drawRoundedRect = (
    ctx: CanvasRenderingContext2D,
    x: number,
    y: number,
    w: number,
    h: number,
    r: number
  ) => {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  };

  const wrapLines = (ctx: CanvasRenderingContext2D, text: string, maxWidth: number, maxLines: number) => {
    const words = text.split(/\s+/);
    const lines: string[] = [];
    let current = '';

    for (const word of words) {
      const candidate = current ? `${current} ${word}` : word;
      if (ctx.measureText(candidate).width <= maxWidth) {
        current = candidate;
      } else {
        if (current) lines.push(current);
        current = word;
        if (lines.length === maxLines - 1) break;
      }
    }
    if (current && lines.length < maxLines) lines.push(current);
    return lines;
  };

  const loadLogoImage = () =>
    new Promise<HTMLImageElement | null>((resolve) => {
      const img = new Image();
      img.onload = () => resolve(img);
      img.onerror = () => resolve(null);
      img.src = '/images/brand/wsp-logo-mark.png';
    });

  const renderMemberCard = async (payload: {
    nickname: string;
    roles: string[];
    tier: string;
    playstyle: string;
    note: string;
  }) => {
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    await document.fonts.ready;
    const logoImg = await loadLogoImage();
    const styles = getComputedStyle(document.documentElement);
    // Selalu gunakan primitif warna merek agar hasil unduhan PNG konsisten di mode terang maupun gelap
    const colIndigo = styles.getPropertyValue('--brand-indigo').trim() || '#1b1464';
    const colIndigoDeep = styles.getPropertyValue('--brand-indigo-deep').trim() || '#110c45';
    const colGold = styles.getPropertyValue('--brand-gold').trim() || '#fbb03b';
    const colSurface = styles.getPropertyValue('--brand-surface-white').trim() || '#ffffff';
    const colInkLight = styles.getPropertyValue('--brand-chalk').trim() || '#f7f6f2';
    const colMutedLight = styles.getPropertyValue('--color-ink-on-dark-muted').trim() || '#c6c3e2';

    const W = 1080;
    const H = 1080;

    // Background Indigo
    ctx.fillStyle = colIndigo;
    ctx.fillRect(0, 0, W, H);

    // Top structural panel
    ctx.fillStyle = colIndigoDeep;
    ctx.fillRect(0, 0, W, 232);

    // Gold base accent bar
    ctx.fillStyle = colGold;
    ctx.fillRect(0, H - 18, W, 18);

    // White logo badge + wordmark
    drawRoundedRect(ctx, 76, 68, 114, 96, 18);
    ctx.fillStyle = colSurface;
    ctx.fill();
    if (logoImg) {
      const ratio = logoImg.naturalWidth / logoImg.naturalHeight;
      const drawH = 62;
      const drawW = drawH * ratio;
      ctx.drawImage(logoImg, 76 + (114 - drawW) / 2, 68 + (96 - drawH) / 2, drawW, drawH);
    }

    ctx.fillStyle = colInkLight;
    ctx.font = '800 44px "Bricolage Grotesque Variable", "Bricolage Grotesque", sans-serif';
    ctx.fillText('Win Streak Party', 216, 114);

    ctx.fillStyle = colMutedLight;
    ctx.font = '600 26px "Plus Jakarta Sans Variable", "Plus Jakarta Sans", sans-serif';
    ctx.fillText('Kartu Member Komunitas Mobile Legends', 216, 154);

    // Nickname
    ctx.fillStyle = colGold;
    ctx.font = '700 26px "Plus Jakarta Sans Variable", "Plus Jakarta Sans", sans-serif';
    ctx.fillText('Nickname / ID Mobile Legends', 76, 326);

    ctx.fillStyle = colInkLight;
    ctx.font = '800 72px "Bricolage Grotesque Variable", "Bricolage Grotesque", sans-serif';
    const nickLines = wrapLines(ctx, payload.nickname, W - 152, 2);
    nickLines.forEach((line, idx) => {
      ctx.fillText(line, 76, 408 + idx * 82);
    });

    // Divider line
    const baseAfterNick = 408 + (nickLines.length - 1) * 82 + 52;
    ctx.fillStyle = 'rgba(247, 246, 242, 0.18)';
    ctx.fillRect(76, baseAfterNick, W - 152, 2);

    // Two structured info blocks: Tier & Role
    const metaY = baseAfterNick + 66;
    ctx.fillStyle = colGold;
    ctx.font = '700 24px "Plus Jakarta Sans Variable", "Plus Jakarta Sans", sans-serif';
    ctx.fillText('Tier saat ini', 76, metaY);
    ctx.fillText('Role utama', 540, metaY);

    ctx.fillStyle = colInkLight;
    ctx.font = '700 36px "Bricolage Grotesque Variable", "Bricolage Grotesque", sans-serif';
    ctx.fillText(payload.tier, 76, metaY + 48);

    const roleLines = wrapLines(ctx, payload.roles.join(', '), 464, 2);
    roleLines.forEach((line, idx) => {
      ctx.fillText(line, 540, metaY + 48 + idx * 44);
    });

    // Fokus / Catatan panel
    const boxY = Math.max(metaY + 140, 720);
    drawRoundedRect(ctx, 76, boxY, W - 152, 186, 20);
    ctx.fillStyle = 'rgba(247, 246, 242, 0.08)';
    ctx.fill();

    ctx.fillStyle = colGold;
    ctx.font = '700 23px "Plus Jakarta Sans Variable", "Plus Jakarta Sans", sans-serif';
    ctx.fillText('Fokus dan catatan main', 108, boxY + 50);

    ctx.fillStyle = colInkLight;
    ctx.font = '500 28px "Plus Jakarta Sans Variable", "Plus Jakarta Sans", sans-serif';
    const noteText = payload.note ? `${payload.playstyle} — ${payload.note}` : payload.playstyle;
    const noteLines = wrapLines(ctx, noteText, W - 216, 3);
    noteLines.forEach((line, idx) => {
      ctx.fillText(line, 108, boxY + 96 + idx * 38);
    });

    // Bottom footer strip
    ctx.fillStyle = colMutedLight;
    ctx.font = '600 25px "Plus Jakarta Sans Variable", "Plus Jakarta Sans", sans-serif';
    ctx.fillText(siteDomain, 76, H - 56);
    ctx.fillStyle = colGold;
    ctx.textAlign = 'right';
    ctx.fillText(siteSlogan, W - 76, H - 56);
    ctx.textAlign = 'left';
  };

  if (form && successBox && previewEl) {
    let latestSummary = '';
    let latestNickname = 'member-wsp';

    // Hapus pesan error secara langsung ketika pengguna memperbaiki input
    const nameInput = document.getElementById('member-name') as HTMLInputElement | null;
    const contactInput = document.getElementById('member-contact') as HTMLInputElement | null;
    const roleCheckboxes = form.querySelectorAll<HTMLInputElement>('input[name="roles"]');
    const errRolesEl = document.getElementById('err-roles');

    nameInput?.addEventListener('input', () => {
      if (nameInput.value.trim().length >= 2) {
        setFieldError('member-name', 'err-name', '');
      }
    });

    contactInput?.addEventListener('input', () => {
      if (contactInput.value.trim().length >= 3) {
        setFieldError('member-contact', 'err-contact', '');
      }
    });

    roleCheckboxes.forEach((checkbox) => {
      checkbox.addEventListener('change', () => {
        const checkedCount = form.querySelectorAll('input[name="roles"]:checked').length;
        if (checkedCount > 0 && errRolesEl) {
          errRolesEl.textContent = '';
          errRolesEl.hidden = true;
        }
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const nickname = String(data.get('nickname') || '').trim();
      const contact = String(data.get('contact') || '').trim();
      const roles = data.getAll('roles').map((v) => String(v));
      const tier = String(data.get('tier') || '');
      const playstyle = String(data.get('playstyle') || '');
      const note = String(data.get('note') || '').trim();

      const website = String(data.get('website') || '').trim();

      if (errFormEl) {
        errFormEl.textContent = '';
        errFormEl.hidden = true;
      }

      let valid = true;

      if (nickname.length < 2) {
        setFieldError('member-name', 'err-name', 'Isi nickname atau ID Mobile Legends minimal 2 karakter.');
        valid = false;
      } else {
        setFieldError('member-name', 'err-name', '');
      }

      if (contact.length < 3) {
        setFieldError('member-contact', 'err-contact', 'Masukkan nomor WhatsApp atau username Discord yang bisa dihubungi.');
        valid = false;
      } else {
        setFieldError('member-contact', 'err-contact', '');
      }

      if (roles.length === 0) {
        if (errRolesEl) {
          errRolesEl.textContent = 'Pilih setidaknya satu role utama yang sering kamu mainkan.';
          errRolesEl.hidden = false;
        }
        valid = false;
      } else if (errRolesEl) {
        errRolesEl.textContent = '';
        errRolesEl.hidden = true;
      }

      if (!valid) {
        const firstInvalid = form.querySelector<HTMLElement>('[aria-invalid="true"]');
        firstInvalid?.focus();
        return;
      }

      const defaultBtnLabel = submitBtn?.textContent?.trim() || 'Kirim ke Discord & buat kartu member';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Mengirim ke Discord...';
      }

      let discordSent = false;
      let fallbackMessage = '';

      try {
        const response = await fetch('/api/join', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            nickname,
            contact,
            roles,
            tier,
            playstyle,
            note,
            website,
          }),
        });

        const result = (await response.json().catch(() => ({}))) as {
          ok?: boolean;
          sent?: boolean;
          code?: string;
          error?: string;
        };

        if (response.status === 429 || response.status === 400) {
          if (errFormEl) {
            errFormEl.textContent = result.error || 'Pengiriman tidak dapat diproses. Periksa kembali data kamu.';
            errFormEl.hidden = false;
          }
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = defaultBtnLabel;
          }
          return;
        }

        if (response.ok && result.sent) {
          discordSent = true;
        } else {
          fallbackMessage =
            result.error ||
            'Pengiriman otomatis ke Discord belum aktif. Kamu tetap bisa menyalin biodata di bawah untuk perkenalan manual.';
        }
      } catch {
        fallbackMessage =
          'Koneksi pengiriman otomatis ke Discord sedang terkendala. Kamu tetap bisa menyalin biodata di bawah untuk perkenalan manual.';
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = defaultBtnLabel;
        }
      }

      latestNickname = nickname.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'member';
      latestSummary = [
        'Halo Win Streak Party, perkenalkan member baru Mobile Legends:',
        `Nickname / ID MLBB: ${nickname}`,
        `Kontak: ${contact}`,
        `Role utama: ${roles.join(', ')}`,
        `Tier saat ini: ${tier}`,
        `Fokus kegiatan: ${playstyle}`,
        note ? `Catatan / Hero andalan: ${note}` : null,
      ]
        .filter(Boolean)
        .join('\n');

      previewEl.textContent = latestSummary;

      if (successTitleEl && successDescEl) {
        if (discordSent) {
          successTitleEl.textContent = 'Biodata terkirim otomatis ke Discord';
          successTitleEl.classList.remove('is-warning');
          successDescEl.textContent =
            'Data pendaftaranmu sudah masuk ke channel Discord Win Streak Party. Unduh kartu member di bawah atau langsung gabung ke grup WhatsApp dan Discord.';
        } else {
          successTitleEl.textContent = 'Kartu member siap — kirim biodata manual';
          successTitleEl.classList.add('is-warning');
          successDescEl.textContent = fallbackMessage;
        }
      }

      form.hidden = true;
      successBox.hidden = false;
      await renderMemberCard({ nickname, roles, tier, playstyle, note });
      announce(
        discordSent
          ? 'Biodata terkirim ke Discord dan kartu member berhasil dibuat.'
          : 'Kartu member berhasil dibuat. Salin biodata untuk dikirim manual.'
      );
      successBox.focus();
    });

    downloadCardBtn?.addEventListener('click', () => {
      if (!canvas) return;
      const link = document.createElement('a');
      link.download = `kartu-member-wsp-${latestNickname}.png`;
      link.href = canvas.toDataURL('image/png');
      link.click();
      announce('Kartu member PNG mulai diunduh.');
    });

    copySummaryBtn?.addEventListener('click', async () => {
      if (!latestSummary) return;
      const original = copySummaryBtn.textContent || 'Salin biodata';
      try {
        await navigator.clipboard.writeText(latestSummary);
        copySummaryBtn.textContent = 'Biodata tersalin';
        announce('Biodata member tersalin ke papan klip.');
      } catch {
        copySummaryBtn.textContent = 'Gagal menyalin otomatis';
        announce('Gagal menyalin biodata otomatis.');
      }
      window.setTimeout(() => {
        copySummaryBtn.textContent = original;
      }, 2200);
    });

    resetFormBtn?.addEventListener('click', () => {
      form.reset();
      form.hidden = false;
      successBox.hidden = true;
      document.getElementById('member-name')?.focus();
    });
  }
</script>
